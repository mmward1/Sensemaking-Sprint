    {
      "@id": "card_dc734b4d-8db7-416e-9121-9ba49bd3d989",
      "@type": "tg:Pattern",
      "type": "Pattern",
      "tier": 2,
      "title": "Algorithmic Disruption Accelerating Stakeholder Exhaustion",
      "description": "Polarized constituents attempting cross-ideological dialogue face automated channel flooding alongside social hostility, driving them to abandon shared civic spaces entirely.",
      "x": 2133,
