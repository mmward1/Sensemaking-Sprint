    {
      "@id": "card_a41c5011-9bf3-4622-829a-e4a4f86766d0",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Ranked voting challenges",
      "description": "Voters face complex new choice architectures while election bodies and civic media fail to deliver clear, accessible candidate information. As a result, voters experience decision paralysis or default to low-information voting, blunting the intended systemic benefits of reform.",
