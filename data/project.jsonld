    {
      "@id": "item_11",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Logistical & Educational Barriers to Voting",
      "description": "Voting is burdened by physical hurdles (childcare, time off work) and a lack of plain-language education on how local elections directly impact citizens' daily lives.",
      "x": 8600,
      "y": 0,
      "w": 240,
      "h": 110,
