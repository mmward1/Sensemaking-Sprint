      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "No Playbook for Good Citizenship",
      "description": "There is no clear guide to the daily, weekly, and monthly steps of being an informed, participating citizen — the information is scattered everywhere, and the whole project feels overwhelming.",
      "x": 0,
      "y": 1000,
      "w": 240,
      "h": 110,
      "verified": false,
