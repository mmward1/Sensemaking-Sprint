      ]
    },
    {
      "@id": "card_4f8e239a-3235-42f3-bccf-78df947d901a",
      "@type": "tg:Pattern",
      "type": "Pattern",
      "tier": 2,
      "title": "High-Risk, Low-Visibility Civic Engagement",
      "description": "Community members and leaders who attempt to communicate or participate in public spaces face intense personal exposure with little transparency into how decisions or power actually operate. Because the risk of participation is high while structural clarity remains low, people self-censor, avoid public office, and disengage from dialogue.",
      "x": 4157,
      "y": -560,
      "w": 300,
      "h": 150,
      "cardType": null,
      "locked": false,
      "children": [
        "card_a168d595-bfad-40f1-9abb-1b65539b7c92",
        "card_772bd853-8b69-42f2-b487-be7915a80117"
      ]
    },
    {
      "@id": "card_d21df978-227c-4f7a-a017-7271f1d6c34f",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Fragmented Channels Fracture Shared Realities",
      "description": "Election officials attempt to communicate across isolated media ecosystems, leaving different social groups to operate on mutually exclusive facts about distant jurisdictions.",
      "x": 3124,
      "y": -280,
      "w": 280,
      "h": 150,
      "cardType": null,
      "locked": false,
      "children": [
        "item_28",
        "item_86c16dd7-803d-4de3-bb83-16ac8ccb93a3"
      ]
    },
    {
      "@id": "card_dd102d6a-2751-433b-a2be-63d559284342",
      "@type": "tg:Pattern",
      "type": "Pattern",
      "tier": 2,
      "title": "Out-of-Jurisdiction Opacity Breeds Assumption of Bad Faith",
      "description": "Because voters only see local election processes firsthand, the unfamiliar rules of distant jurisdictions appear mysterious—leading people to fill those information voids with suspicions of partisan cheating.",
      "x": 3238,
      "y": -560,
      "w": 300,
      "h": 150,
      "cardType": null,
      "locked": false,
