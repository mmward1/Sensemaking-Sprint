      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Representatives Without Accountability",
      "description": "Representatives don't seem to answer to the people, and replacing them changes little — new reps inherit the same voting patterns, with the two-party system and polarization at the crux.",
