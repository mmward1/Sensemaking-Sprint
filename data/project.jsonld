    {
      "@id": "card_d0ee16cd-ed1c-4c93-a0d0-a81f0f114b9f",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Digital Channels Alienating Polarized Constituents",
      "description": "Differing political groups encounter AI-generated interference whenever they attempt online dialogue, driving them away from shared digital spaces. Consequently, new civic engagement tools only exacerbate isolation rather than bridging differences.",
      "x": 1444,
      "y": -280,
