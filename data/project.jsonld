      ]
    },
    {
      "@id": "card_772bd853-8b69-42f2-b487-be7915a80117",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Information Friction in Civic Power",
      "description": "Voters and stretched legislative staff operate without a shared baseline of who holds power and how fast it moves, causing civic outreach tools to fail at bridging the gap.",
      "x": 4132,
      "y": -280,
      "w": 280,
      "h": 150,
      "cardType": null,
      "locked": false,
      "children": [
        "item_30",
