      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Procedural Friction Triggers Civic Withdrawal",
      "description": "Voters facing convoluted voting mechanics, such as ranked-choice rules, and a polluted information environment opt out of participating rather than navigate a system they cannot decode.",
      "x": 15596,
      "y": -280,
      "w": 280,
      "h": 150,
      "cardType": null,
      "locked": false,
