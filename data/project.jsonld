    },
    {
      "@id": "card_a168d595-bfad-40f1-9abb-1b65539b7c92",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "High-Risk, Low-Information Civic Spaces",
      "description": "Citizens and potential leaders experience local politics as an opaque, media-dominated environment, driving voter apathy and self-selection out of public leadership.",
      "x": 4522,
      "y": -280,
      "w": 280,
      "h": 150,
      "cardType": null,
      "locked": false,
      "children": [
        "item_06",
